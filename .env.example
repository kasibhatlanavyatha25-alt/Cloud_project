# Copy frontend variables into frontend/.env.local. Never commit real secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_API_BASE_URL=http://localhost:5000
VITE_USE_FIREBASE_EMULATORS=false

# Set on backend process/service (Render's environment settings).
FLASK_SECRET_KEY=replace-with-a-random-secret
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
FRONTEND_ORIGINS=http://localhost:5173
MODEL_PATH=ml/artifacts/heart_disease.joblib
METRICS_PATH=ml/artifacts/metrics.json
